<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by scripts/bundle.sh only when KARUNMANAGER_PROFILE points at a provisioning profile.
     TEAM_ID is replaced with the profile's team identifier at build time. -->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>TEAM_ID.com.karungopal.KarunManager</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAM_ID</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.karungopal.KarunManager</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>TEAM_ID.com.karungopal.KarunManager</string>
	<key>com.apple.developer.aps-environment</key>
	<string>APS_ENVIRONMENT</string>
</dict>
</plist>
