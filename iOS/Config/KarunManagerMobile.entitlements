<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Only used when Local.xcconfig sets CODE_SIGN_ENTITLEMENTS. Matches Resources/KarunManager.entitlements
     (the Mac app) so both apps share one CloudKit container and one key-value store. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.karungopal.KarunManager</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.karungopal.KarunManager</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
