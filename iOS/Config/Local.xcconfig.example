// Copy to Local.xcconfig (gitignored) to run on your iPhone.

// Your Apple Developer team ID (Xcode → Settings → Accounts, or developer.apple.com → Membership).
DEVELOPMENT_TEAM = ABCDE12345

// iCloud sync with the Mac app. Needs a paid developer account (see README → iPhone app).
// Leave these two out to run on your phone with tasks kept on the device only.
CODE_SIGN_ENTITLEMENTS = Config/KarunManagerMobile.entitlements
KM_CLOUDKIT_CONTAINER = iCloud.com.karungopal.KarunManager
